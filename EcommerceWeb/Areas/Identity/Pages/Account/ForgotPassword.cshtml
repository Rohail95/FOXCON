@page
@model EcommerceWeb.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<!-- Apply our custom styling -->
<link rel="stylesheet" href="~/css/identity.css" asp-append-version="true" />
<body class="identity-page">
</body>

<div class="identity-container">
    <h1>@ViewData["Title"]</h1>
    <h4 class="fw-light">Enter your email address and we will send you a link to reset your password.</h4>
    <hr />
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="form-floating mb-3">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            <label asp-for="Input.Email" class="form-label"></label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <button type="submit" class="w-100 btn btn-lg btn-primary">Reset Password</button>
    </form>
    <div class="identity-links mt-3">
        <a asp-page="./Login">Back to Login</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}