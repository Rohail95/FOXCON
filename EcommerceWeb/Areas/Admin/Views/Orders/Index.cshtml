@model IEnumerable<DatabaseLayer.Models.Order>
@{
    ViewData["Title"] = "Manage Orders";
}

<div class="card">
    <div class="card-header"><h3 class="card-title">All Customer Orders</h3></div>
    <div class="card-body">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer Name</th>
                    <th>Order Date</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th style-="width: 120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center">No orders found.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#@item.OrderId</td>
                        <td>@(item.Customer?.FirstName ?? "N/A") @(item.Customer?.LastName)</td>
                        <td>@item.OrderDate.ToString("dd MMM yyyy")</td>
                        <td>Rs @item.TotalAmount.ToString("N2")</td>

                        <td>
                            @{
                                var badgeClass = "bg-secondary"; 
                                switch (item.Status)
                                {
                                    case "Pending": badgeClass = "bg-warning"; break;
                                    case "Processing": badgeClass = "bg-info"; break;
                                    case "Shipped": badgeClass = "bg-primary"; break;
                                    case "Delivered": badgeClass = "bg-success"; break;
                                    case "Cancelled": badgeClass = "bg-danger"; break;
                                }
                            }
                            <span class="badge @badgeClass">@item.Status</span>
                        </td>
                                               <td>
                            <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-info btn-sm">View Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>    