@model IEnumerable<DatabaseLayer.Models.Product>

@{
    ViewData["Title"] = "Manage Products";
}

<div class="row">
    <div class="col-12">
        <h1 class="m-0">Manage Products</h1>
        <p class="mb-3">Here you can add, edit, or delete products in your store.</p>
    </div>
</div>

<div class="row mb-3">
    <div class="col-12">
        <a href="/Admin/Products/Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Product
        </a>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">All Products</h3>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th style="width: 150px;">Actions</th>
                        </tr>
                    </thead>
                  <tbody>
                        @foreach (var item in Model)
                        {
                      <tr>

                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" style="width: 100px; height: auto;" />
                            }
                            else
                            {
                                <span>No Image</span>
                            }
                        </td>

                           
                                <td>@item.Name</td>
                                
                                <td>@(item.Category?.Name ?? "N/A")</td>
                                <td>Rs @item.Price.ToString("N2")</td>
                                <td>@item.StockQuantity</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-info">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
        </div>
       
    </div>
</div>