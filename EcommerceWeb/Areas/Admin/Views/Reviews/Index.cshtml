@model IEnumerable<DatabaseLayer.Models.Review>
@{
    ViewData["Title"] = "Manage Reviews";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Customer Product Reviews</h3>
    </div>
    <div class="card-body">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Customer</th>
                    <th>Rating</th>
                    <th>Comment</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var review in Model)
                {
                    <tr>
                        <td>@review.Product?.Name</td>
                        <td>@review.Customer?.FirstName @review.Customer?.LastName</td>
                        <td class="text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="fa-star @(i <= review.Rating ? "fas" : "far")"></i>
                            }
                        </td>
                        <td>@review.Comment</td>
                        <td>
                            @{
                                var badgeClass = review.Status == "Approved" ? "bg-success" : "bg-warning";
                            }
                            <span class="badge @badgeClass">@review.Status</span>
                        </td>
                        <td>
                            @if (review.Status != "Approved")
                            {
                                <form asp-action="Approve" asp-route-id="@review.ReviewId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                </form>
                            }
                            <form asp-action="Delete" asp-route-id="@review.ReviewId" method="post" class="d-inline" onsubmit="return confirm('Are you sure?');">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>