@model DatabaseLayer.Models.Category

@{
    ViewData["Title"] = "Create New Category";
}

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">Enter New Category Details</h3>
    </div>
    <form id="createCategoryForm">
        <div class="card-body">
            <div id="error-summary" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name">Category Name</label>

                <input asp-for="Name" id="categoryName" class="form-control" placeholder="Enter category name">
            </div>

            <div class="form-group">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" id="categoryDescription" class="form-control" rows="3" placeholder="Enter a brief description"></textarea>
            </div>
        </div>

        <div class="card-footer">
            
            <button type="button" id="createCategoryBtn" class="btn btn-primary">Create Category</button>
            <a href="/Admin/Categories" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>
@section Scripts {
    <script>
        
        document.addEventListener('DOMContentLoaded', function () {

            const createButton = document.getElementById('createCategoryBtn');

            createButton.addEventListener('click', function (event) {
                event.preventDefault();

                const categoryName = document.getElementById('categoryName').value;
                const categoryDescription = document.getElementById('categoryDescription').value;

                const categoryData = {
                    name: categoryName,
                    description: categoryDescription
                };
                fetch('/Admin/Categories/CreateApi', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(categoryData)
                })
                .then(response => {
                    if (response.ok) {
                        window.location.href = '/Admin/Categories';
                    } else {
                        alert('Error: Could not create the category.');
                    }
                })
                .catch(error => {
                    console.error('Fetch Error:', error);
                    alert('A network error occurred. Please try again.');
                });
            });
        });
    </script>
}
