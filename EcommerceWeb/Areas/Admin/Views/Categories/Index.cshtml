@model IEnumerable<DatabaseLayer.Models.Category>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="row">
    <div class="col-12">
        <p class="mb-3">Here you can add, edit, or delete product categories.</p>
        <a href="/Admin/Categories/Create" class="btn btn-primary mb-3">
            <i class="fas fa-plus"></i> Create New Category
        </a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">All Categories</h3>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th style="width: 150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Description</td>
                                <td>
                                    <a href="/Admin/Categories/Edit/@item.CategoryId" class="btn btn-sm btn-info">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a href="/Admin/Categories/Delete/@item.CategoryId" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>