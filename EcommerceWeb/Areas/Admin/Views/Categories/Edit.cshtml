@model DatabaseLayer.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">Edit Category: @Model.Name</h3>
    </div>
    <form id="editCategoryForm">
        <div class="card-body">
            <input type="hidden" id="categoryId" value="@Model.CategoryId" />

            <div class="form-group">
                <label asp-for="Name">Category Name</label>
                <input asp-for="Name" id="categoryName" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" id="categoryDescription" class="form-control" rows="3"></textarea>
            </div>
        </div>
        <div class="card-footer">
            <button type="button" id="saveChangesBtn" class="btn btn-primary">Save Changes</button>
            <a href="/Admin/Categories" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const saveButton = document.getElementById('saveChangesBtn');

            saveButton.addEventListener('click', function (event) {
                event.preventDefault();

                const categoryId = parseInt(document.getElementById('categoryId').value);
                const categoryName = document.getElementById('categoryName').value;
                const categoryDescription = document.getElementById('categoryDescription').value;

                const categoryData = {
                    categoryId: categoryId,
                    name: categoryName,
                    description: categoryDescription
                };

                fetch('/Admin/Categories/EditApi', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(categoryData)
                })
                .then(response => {
                    if (response.ok) {
                        window.location.href = '/Admin/Categories';
                    } else {
                        alert('Error: Could not update the category.');
                    }
                })
                .catch(error => {
                    console.error('Fetch Error:', error);
                    alert('A network error occurred. Please try again.');
                });
            });
        });
    </script>
}