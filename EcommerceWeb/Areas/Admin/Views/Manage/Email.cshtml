@model EcommerceWeb.ViewModels.AdminChangeEmailViewModel
@{
    ViewData["Title"] = "Change Email";
    Layout = "_AdminAccountLayout.cshtml";
}

<div class="card card-primary">
    <div class="card-header"><h3 class="card-title">@ViewData["Title"]</h3></div>
    <form asp-action="Email" method="post">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label>Current Email</label>
                <input class="form-control" value="@User.Identity.Name" disabled />
            </div>
            <div class="form-group">
                <label asp-for="NewEmail"></label>
                <input asp-for="NewEmail" class="form-control" />
                <span asp-validation-for="NewEmail" class="text-danger"></span>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Update Email</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}