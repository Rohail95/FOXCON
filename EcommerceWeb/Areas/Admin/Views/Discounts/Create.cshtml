@model EcommerceWeb.ViewModels.DiscountViewModel
@{
    ViewData["Title"] = "Create Discount";
}

<div class="card card-primary">
    <div class="card-header"><h3 class="card-title">Create New Discount</h3></div>

    <form asp-action="Create" method="post">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Discount.Code">Coupon Code</label>
                <input asp-for="Discount.Code" class="form-control" placeholder="e.g., SUMMER25" />
                <span asp-validation-for="Discount.Code" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Discount.DiscountType">Discount Type</label>
                        <select asp-for="Discount.DiscountType" class="form-control">
                            <option value="Fixed">Fixed Amount (Rs)</option>
                            <option value="Percentage">Percentage (%)</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Discount.DiscountValue">Value</label>
                        <input asp-for="Discount.DiscountValue" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Discount.DiscountValue" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Discount.StartDate"></label>
                        <input asp-for="Discount.StartDate" class="form-control" type="date" />
                        <span asp-validation-for="Discount.StartDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Discount.EndDate"></label>
                        <input asp-for="Discount.EndDate" class="form-control" type="date" />
                        <span asp-validation-for="Discount.EndDate" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Discount.Description"></label>
                <input asp-for="Discount.Description" class="form-control" />
            </div>

            <hr />

            <div class="form-group">
                <label>Apply to Specific Products (Optional)</label>
                <p><small>If no products are selected, the discount will apply to the entire cart.</small></p>
                <select asp-for="SelectedProductIds" asp-items="@Model.Products" class="form-control" style="height: 200px;"></select>
            </div>

        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Create Discount</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>