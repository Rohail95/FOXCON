@{
    ViewData["Title"] = "About Us";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto text-center">
            <h1 class="display-4">About FOXCON</h1>
            <p class="lead text-muted mb-4">Your trusted source for quality products and exceptional service.</p>
        </div>
    </div>

    <div class="row align-items-center">
        <div class="col-lg-6">
            <h3>Our Story</h3>
            <p>Welcome to FOXCON! We started in 2025 with a simple idea: to provide top-quality products without the premium price tag. What began in a small office has grown into a thriving online store, serving thousands of happy customers all over the country. We believe that everyone deserves access to the best, and we work tirelessly to source, test, and deliver products that we are proud to stand behind.</p>
            <h3>Our Mission</h3>
            <p>Our mission is to build a lasting relationship with our customers by providing an outstanding shopping experience from start to finish. We are committed to offering a curated selection of excellent products, fast and reliable shipping, and a customer support team that is always ready to help. At FOXCON, you're not just a customer; you're part of our community.</p>
        </div>
        <div class="col-lg-6 text-center">
            <!-- You can replace this with a picture of your storefront, team, or a lifestyle image -->
            <img src ="~/images/banners/banner6.jpg" class="img-fluid rounded shadow-sm" alt="Our Team">
        </div>
    </div>
</div>