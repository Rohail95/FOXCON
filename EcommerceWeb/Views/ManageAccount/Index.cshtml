@model EcommerceWeb.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "My Account";
}

<div class="row">
    <div class="col-lg-8">
        <h1 class="mb-4">@ViewData["Title"]</h1>
        <p>Update your personal information and shipping details here.</p>

        <form asp-action="Index" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label class="form-label">Profile Picture</label>
                <div>
                    @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                    {
                        <img src="@Url.Content(Model.ExistingImageUrl)" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover;" alt="Profile Picture" />
                    }
                    else
                    {
                        <img src="~/images/default-avatar.png" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover;" alt="Default Avatar" />
                    }
                </div>
                <div class="mt-2">
                    <label asp-for="ProfileImage" class="form-label"></label>
                    <input asp-for="ProfileImage" class="form-control" type="file" accept="image/*" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /></div>
            </div>
            <div class="mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
            <hr />
            <h4 class="mt-4 mb-3">Shipping Address</h4>
            <div class="mb-3"><label asp-for="Address">Street Address</label><input asp-for="Address" class="form-control" /></div>
            <div class="row mb-3">
                <div class="col-md-4"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="PostalCode" class="form-label"></label><input asp-for="PostalCode" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="Country" class="form-label"></label><input asp-for="Country" class="form-control" /></div>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}