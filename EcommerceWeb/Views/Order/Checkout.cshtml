@model EcommerceWeb.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .checkout-container {
        display: flex;
        flex-wrap: wrap;
    }

    .main-content {
        flex: 1 1 55%;
        padding-right: 2em;
    }

    .sidebar-content {
        flex: 1 1 40%;
        background-color: #f8f9fa;
        padding: 2em;
        border-left: 1px solid #dee2e6;
        border-radius: 6px;
    }

    .payment-option {
        border: 1px solid #ddd;
        padding: 1rem;
        border-radius: 5px;
        cursor: pointer;
    }

        .payment-option:has(input:checked) {
            border-color: #0d6efd;
            box-shadow: 0 0 0 2px #0d6efd;
        }
</style>

<div class="container my-5">
    <div class="checkout-container">

        <div class="main-content">
            <h3>Foxcon</h3>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index">Cart</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Information</li>
                </ol>
            </nav>

            <form asp-controller="Checkout" asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <h4>Contact</h4>
                <div class="mb-3">
                    <input asp-for="Email" class="form-control" placeholder="Email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <h4 class="mt-4">Shipping address</h4>
                <div class="row">
                    <div class="col-md-6 mb-3"><input asp-for="FirstName" class="form-control" placeholder="First Name" /></div>
                    <div class="col-md-6 mb-3"><input asp-for="LastName" class="form-control" placeholder="Last Name" /></div>
                </div>
                <div class="mb-3"><input asp-for="Address" class="form-control" placeholder="Address" /></div>
                <div class="row">
                    <div class="col-md-4 mb-3"><input asp-for="City" class="form-control" placeholder="City" /></div>
                    <div class="col-md-4 mb-3"><input asp-for="PostalCode" class="form-control" placeholder="Postal Code" /></div>
                    <div class="col-md-4 mb-3"><input asp-for="Country" class="form-control" placeholder="Country" /></div>
                </div>
                <div class="mb-3"><input asp-for="Phone" class="form-control" placeholder="Phone" /></div>

                <hr />
                <h4 class="mt-4">Payment</h4>
                <p>All transactions are secure and encrypted.</p>

                <div class="payment-option mb-2">
                    <input type="radio" id="cod" name="PaymentMethod" value="Cash on Delivery" class="form-check-input" checked>
                    <label for="cod">Cash on Delivery (COD)</label>
                </div>
                <div class="payment-option mb-2">
                    <input type="radio" id="bank" name="PaymentMethod" value="Bank Transfer" class="form-check-input">
                    <label for="bank">Bank Transfer</label>
                </div>
                <div class="payment-option mb-2">
                    <input type="radio" id="easypaisa" name="PaymentMethod" value="Easypaisa" class="form-check-input">
                    <label for="easypaisa">Easypaisa</label>
                </div>
                <span asp-validation-for="PaymentMethod" class="text-danger"></span>


                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">Place Your Order</button>
                </div>
            </form>
        </div>


        <aside class="sidebar-content">
            @if (Model.CartItems.Any())
            {
                @foreach (var item in Model.CartItems)
                {
                    <div class="d-flex mb-3 align-items-center">
                        <div class="flex-shrink-0">
                            <img src="@(item.Product.ImageUrl ?? "https://via.placeholder.com/64")" alt="@item.Product.Name" style="width: 64px; height: 64px; object-fit: cover; border-radius: 8px;">
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <strong>@item.Product.Name</strong> (x @item.Quantity)
                        </div>
                        <div class="text-nowrap">Rs @((item.Product.Price * item.Quantity).ToString("N2"))</div>
                    </div>
                }
                <hr />
                <div class="d-flex justify-content-between">
                    <span>Subtotal</span>
                    <span>Rs @Model.CartTotal.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between text-muted">
                    <span>Shipping</span>
                    <span>Free</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between h5">
                    <strong>Total</strong>
                    <strong>Rs @Model.CartTotal.ToString("N2")</strong>
                </div>

            }

        </aside>
    </div>
</div>
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}