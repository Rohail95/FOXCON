@model EcommerceWeb.ViewModels.ProductViewModel
@using DatabaseLayer.Models 
@{
    ViewData["Title"] = Model.Product.Name;
}

<div class="container my-5">
    <div class="row">
        <!-- Product Image Gallery -->
        <div class="col-lg-6 mb-4">
            <div class="card">
                <div class="card-body text-center">
                    <img src="@Model.Product.ImageUrl" class="img-fluid rounded" alt="@Model.Product.Name" style="max-height: 500px;">
                </div>
            </div>
        </div>
        <!-- Product Information & Actions -->
        <div class="col-lg-6">
            <span class="badge bg-primary mb-2">@Model.Product.Category?.Name</span>
            <h1 class="display-5">@Model.Product.Name</h1>

            <div class="price-section my-3">
                @if (Model.IsOnSale)
                {
                        <h2 class="text-danger fw-bold">Rs @Model.DisplayPrice.ToString("N2") <del class="text-muted fs-4 ms-2">Rs @Model.OriginalPrice?.ToString("N2")</del></h2>
                }
                else
                {
                        <h2 class="fw-bold">Rs @Model.DisplayPrice.ToString("N2")</h2>
                }
            </div>

            <p class="lead">@Model.Product.Description</p>

            <div class="d-flex justify-content-between text-muted small mt-3">
                <span>SKU: @Model.Product.Sku</span>
                <span>
                    @if (Model.Product.StockQuantity > 0)
                    {
                            <span class="text-success">In Stock (@Model.Product.StockQuantity left)</span>
                    }
                    else
                    {
                            <span class="text-danger">Out of Stock</span>
                    }
                </span>
            </div>

            <hr class="my-4">

            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                <input type="hidden" name="productId" value="@Model.Product.ProductId" />
                <div class="row">
                    <div class="col-md-4">
                        <label for="quantity" class="form-label">Quantity</label>
                        <input type="number" name="quantity" id="quantity" class="form-control" value="1" min="1" max="@Model.Product.StockQuantity" />
                    </div>
                    <div class="col-md-8 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@(Model.Product.StockQuantity < 1)">
                            <i class="fas fa-shopping-cart me-2"></i>Add to Cart
                        </button>
                    </div>
                </div>
            </form>
            <form asp-controller="Checkout" asp-action="AddToCartAndCheckout" method="post" class="flex-grow-1">
                <input type="hidden" name="productId" value="@Model.Product.ProductId" />
                <button type="submit" class="btn btn-success btn-lg w-100">Buy Now</button>
            </form>
            <a asp-action="Index" class="btn btn-outline-secondary mt-3">Back to Shop</a>
        </div>
    </div>

    <!-- REVIEWS SECTION -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3>Customer Reviews (@(Model.Product.Reviews?.Count ?? 0))</h3>
                </div>
                <div class="card-body">
                    @if (User.Identity.IsAuthenticated)
                    {
                            <h5>Leave a Review</h5>
                            <form asp-controller="Reviews" asp-action="Add" method="post">
                                <input type="hidden" name="productId" value="@Model.Product.ProductId" />
                                <div class="form-group mb-2"><label for="rating">Your Rating</label><select name="rating" id="rating" class="form-control" required><option value="5">5 Stars</option><option value="4">4 Stars</option><option value="3">3 Stars</option><option value="2">2 Stars</option><option value="1">1 Star</option></select></div>
                                <div class="form-group mb-2"><label for="comment">Your Review</label><textarea name="comment" id="comment" rows="3" class="form-control" required></textarea></div>
                                <button type="submit" class="btn btn-primary">Submit Review</button>
                            </form>
                    }
                    else
                    {
                            <p><a asp-area="Identity" asp-page="/Account/Login">Login</a> to leave a review.</p>
                    }
                    <hr />

                    @{
                        var approvedReviews = Model.Product.Reviews?.Where(r => r.Status == "Approved") ?? Enumerable.Empty<Review>();
                    }

                    <h4>Approved Reviews (@approvedReviews.Count())</h4>

                    @if (approvedReviews.Any())
                    {
                            @foreach (var review in approvedReviews.OrderByDescending(r => r.ReviewDate))
                            {
                                    <div class="d-flex mb-3 pt-3 border-top">
                                        <div class="flex-shrink-0"><i class="fas fa-user-circle fa-2x"></i></div>
                                        <div class="flex-grow-1 ms-3">
                                            <strong>@(review.Customer?.FirstName ?? "Anonymous")</strong>
                                            <p class="text-warning mb-1">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="fa-star @(i <= review.Rating ? "fas" : "far")"></i>
                                                }
                                            </p>
                                            <p class="mb-1">@review.Comment</p>
                                            <small class="text-muted">@review.ReviewDate?.ToString("dd MMMM, yyyy")</small>
                                        </div>
                                    </div>
                            }
                    }
                    else
                    {
                            <p>This product has no approved reviews yet. Be the first!</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>