@model IEnumerable<EcommerceWeb.ViewModels.ProductViewModel>
@using EcommerceWeb.ViewModels
@{
    ViewData["Title"] = "Welcome to FOXCON";
}

<!-- HERO IMAGE SLIDER -->
<div id="heroCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="3"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="4"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/images/banners/banner1.jpg" class="d-block w-100" alt="Summer Sale Banner">
        </div>
        <div class="carousel-item">
            <img src ="~/images/banners/banner2.jpg" class="d-block w-100" alt="New Arrivals Banner">
        </div>
        <div class="carousel-item">
            <img src="~/images/banners/banner3.jpg" class="d-block w-100" alt="New Arrivals Banner">
        </div>
        <div class="carousel-item">
            <img src="~/images/banners/banner8.jpg" class="d-block w-100" alt="New Arrivals Banner">
        </div>
        <div class="carousel-item">
            <img src="~/images/banners/banner5.jpg" class="d-block w-100" alt="New Arrivals Banner">
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
</div>

<!-- FEATURED PRODUCTS (DEALS OF THE WEEK) -->
@{
    var featuredProducts = ViewBag.FeaturedProducts as List<ProductViewModel>;
}
@if (featuredProducts != null && featuredProducts.Any())
{
    <div class="text-center">
        <h2 class="display-5">Deals Of The Week</h2>
        <p class="lead text-muted">Check out our best offers, selected just for you.</p>
    </div>
    <div class="row">
        @foreach (var viewModel in featuredProducts)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100">
                    <a asp-action="Details" asp-route-id="@viewModel.Product.ProductId"><img src="@viewModel.Product.ImageUrl" class="card-img-top" alt="@viewModel.Product.Name" style="height: 200px; object-fit: contain; padding: 10px;"></a>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title"><a asp-action="Details" asp-route-id="@viewModel.Product.ProductId">@viewModel.Product.Name</a></h5>
                        <div class="price mt-auto">
                            @if (viewModel.IsOnSale)
                            {
                                <span class="text-danger font-weight-bold" style="font-size: 1.1rem;">Rs @viewModel.DisplayPrice.ToString("N2")</span>
                                <del class="text-muted ms-2">Rs @viewModel.OriginalPrice?.ToString("N2")</del>
                            }
                            else
                            {
                                <span class="font-weight-bold" style="font-size: 1.1rem;">Rs @viewModel.DisplayPrice.ToString("N2")</span>
                            }
                        </div>
                        <p class="card-text text-muted small">@viewModel.Product.Category?.Name</p>
                        <form asp-controller="Cart" asp-action="AddToCart" method="post"><input type="hidden" name="productId" value="@viewModel.Product.ProductId" /><input type="hidden" name="quantity" value="1" /><button type="submit" class="btn btn-primary w-100 mt-2">Add To Cart</button></form>
                    </div>
                </div>
            </div>
        }
    </div>
    <hr class="my-5" />
}

<!-- This is your existing 'ALL PRODUCTS' section -->
@if (ViewData["SearchTerm"] != null)
{
    <h2 class="text-center mb-4">Search Results for: "@ViewData["SearchTerm"]"</h2>
}
else if (ViewData["CategoryTitle"] != null)
{
    <h2 class="text-center mb-4">@ViewData["CategoryTitle"]</h2>
}
else
{
    <div class="text-center">
        <h1 class="display-4">All Products</h1>
        <p>Browse our entire collection.</p>
    </div>
}
<div class="row">
    @foreach (var viewModel in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100">
                <a asp-action="Details" asp-route-id="@viewModel.Product.ProductId"><img src="@viewModel.Product.ImageUrl" class="card-img-top" alt="@viewModel.Product.Name" style="height: 200px; object-fit: contain; padding: 10px;"></a>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title"><a asp-action="Details" asp-route-id="@viewModel.Product.ProductId">@viewModel.Product.Name</a></h5>
                    <div class="price mt-auto">
                        @if (viewModel.IsOnSale)
                        {
                            <span class="text-danger font-weight-bold" style="font-size: 1.1rem;">Rs @viewModel.DisplayPrice.ToString("N2")</span>
                            <del class="text-muted ms-2">Rs @viewModel.OriginalPrice?.ToString("N2")</del>
                        }
                        else
                        {
                            <span class="font-weight-bold" style="font-size: 1.1rem;">Rs @viewModel.DisplayPrice.ToString("N2")</span>
                        }
                    </div>
                    <p class="card-text text-muted small">@viewModel.Product.Category?.Name</p>
                    <form asp-controller="Cart" asp-action="AddToCart" method="post"><input type="hidden" name="productId" value="@viewModel.Product.ProductId" /><input type="hidden" name="quantity" value="1" /><button type="submit" class="btn btn-primary w-100 mt-2">Add To Cart</button></form>
                </div>
            </div>
        </div>
    }
</div>